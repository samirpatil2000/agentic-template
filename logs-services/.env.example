LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
PROMTAIL_BASIC_AUTH_USERNAME=admin
PROMTAIL_BASIC_AUTH_PASSWORD=admin
GF_SERVER_ROOT_URL=http://localhost:4000/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
MAX_ENTRIES_LIMIT_PER_QUERY=5000

LOKI_OBJECT_STORE=filesystem

# For S3 object storage config:
# LOKI_OBJECT_STORE=s3
# LOKI_S3_BUCKET=s3://<bucket-name>.s3.amazonaws.com
# LOKI_BUCKET_ACCESS_KEY_ID=<aws-access-key-id>
# LOKI_BUCKET_SECRET_ACCESS_KEY=<aws-secret-access-key>
# LOKI_BUCKET_REGION=us-east-1

# For GCS object storage config:
# LOKI_OBJECT_STORE=gcs
# LOKI_GS_BUCKET=<gcs-bucket-name>
# GOOGLE_APPLICATION_CREDENTIALS=/app/keys/default/gcp-bucket-sa.json
